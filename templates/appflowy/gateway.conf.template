resolver ${DNS_RESOLVER} valid=10s;
map $http_upgrade $connection_upgrade { default upgrade; "" close; }
server {
 listen 8080;
 listen [::]:8080;
 client_max_body_size 256m;
 proxy_http_version 1.1;
 proxy_set_header Host $http_host;
 proxy_set_header X-Forwarded-Proto https;
 proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
 proxy_set_header Upgrade $http_upgrade;
 proxy_set_header Connection $connection_upgrade;
 proxy_read_timeout 3600s;
set $api "http://${API_HOST}:8000";
set $auth "http://${AUTH_HOST}:9999";
set $web "http://${WEB_HOST}:80";
set $admin "http://${ADMIN_HOST}:3000";
location /gotrue/ { rewrite ^/gotrue(/.*)$ $1 break; proxy_pass $auth; }
location /api { proxy_request_buffering off; proxy_pass $api; }
location /ws { proxy_pass $api; }
location /console { proxy_pass $admin; }
location = /healthz { proxy_pass $api/api/server-info; }
location / { proxy_pass $web; }
}
