resolver ${DNS_RESOLVER} valid=10s;
map $http_upgrade $connection_upgrade { default upgrade; "" close; }
server {
 listen 8080;
 listen [::]:8080;
 client_max_body_size 256m;
 proxy_http_version 1.1;
 proxy_set_header Host $http_host;
 proxy_set_header X-Forwarded-Proto https;
 proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
 proxy_set_header Upgrade $http_upgrade;
 proxy_set_header Connection $connection_upgrade;
 proxy_read_timeout 3600s;
set $api "http://${API_HOST}:80";
set $realtime "http://${REALTIME_HOST}:80";
set $console "http://${CONSOLE_HOST}:3000";
location /v1/realtime { proxy_pass $realtime; }
location /.well-known { proxy_pass $api; }
location /v1 { proxy_pass $api; }
location = /healthz { proxy_pass $api/v1/health/version; }
location / { proxy_pass $console; }
}
