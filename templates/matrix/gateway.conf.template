resolver ${DNS_RESOLVER} valid=10s;
map $http_upgrade $connection_upgrade { default upgrade; "" close; }
server {
 listen 8080;
 listen [::]:8080;
 client_max_body_size 256m;
 proxy_http_version 1.1;
 proxy_set_header Host $http_host;
 proxy_set_header X-Forwarded-Proto https;
 proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
 proxy_set_header Upgrade $http_upgrade;
 proxy_set_header Connection $connection_upgrade;
 proxy_read_timeout 3600s;
set $synapse "http://${SYNAPSE_HOST}:8008";
set $mas "http://${MAS_HOST}:8080";
location = /.well-known/matrix/server { default_type application/json; return 200 '{"m.server":"${PUBLIC_HOST}:443"}'; }
location = /.well-known/matrix/client { add_header Access-Control-Allow-Origin *; default_type application/json; return 200 '{"m.homeserver":{"base_url":"https://${PUBLIC_HOST}"}}'; }
location ~ ^/_matrix/client/(.*)/(login|logout|refresh)$ { proxy_pass $mas; }
location /_matrix { proxy_pass $synapse; }
location /_synapse/client { proxy_pass $synapse; }
location /_synapse/admin { return 403; }
location = /healthz { proxy_pass $synapse/health; }
location / { return 404; }
}
