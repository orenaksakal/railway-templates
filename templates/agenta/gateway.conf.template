map $http_upgrade $connection_upgrade { default upgrade; '' close; }
map $http_x_template_key $owner_realm { default "${AUTH_REALM}"; "${ACCESS_PASSWORD}" off; }
map $http_authorization $upstream_authorization { default $http_authorization; ~^Basic\s ""; }
server {
 listen 8080;
 listen [::]:8080;
 resolver ${DNS_RESOLVER} valid=10s;
 client_max_body_size 32m;
 auth_basic $owner_realm;
 auth_basic_user_file /etc/nginx/htpasswd;
 location = /healthz { auth_basic off; return 200 'gateway ready'; }
 location /api/ {
  set $upstream "${API_HOST}:8000";
  rewrite ^/api/(.*)$ /$1 break;
  include /etc/nginx/proxy.inc;
 }
 location /services/ {
  set $upstream "${SERVICES_HOST}:8080";
  rewrite ^/services/(.*)$ /$1 break;
  include /etc/nginx/proxy.inc;
 }
 location ~ ^/m(/|$) { set $upstream "${MOBILE_HOST}:8080"; include /etc/nginx/proxy.inc; }
 location / { set $upstream "${UPSTREAM_HOST}:8080"; include /etc/nginx/proxy.inc; }
}
