{
  "services": {
    "d839ef05-ed6e-5e5c-9e2d-271652f63ce2": {
      "name": "redis",
      "source": {
        "image": "redis:7.4@sha256:71da9275c5f3fcb97d0fa0c8c5b36cc995327265420f17a04bfd544f458059f7"
      },
      "variables": {
        "REDIS_PASSWORD": {
          "isOptional": false,
          "description": "Generated private Redis/Valkey password, or a reference to that password. Keep secret.",
          "defaultValue": "${{secret(64, \"abcdef0123456789\")}}"
        },
        "REDIS_URL": {
          "isOptional": false,
          "description": "Private authenticated Redis/Valkey connection URL. Automatically assembled from service references.",
          "defaultValue": "redis://:${{redis.REDIS_PASSWORD}}@${{redis.RAILWAY_PRIVATE_DOMAIN}}:6379"
        }
      },
      "deploy": {
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10,
        "startCommand": "sh -c 'exec redis-server --bind 0.0.0.0 :: --appendonly yes --maxmemory-policy noeviction --requirepass \"$REDIS_PASSWORD\"'",
        "requiredMountPath": "/data"
      },
      "networking": {
        "serviceDomains": {}
      },
      "volumeMounts": {
        "623ea7a2-1826-5278-87cc-fb0123bbac1d": {
          "mountPath": "/data"
        }
      }
    },
    "2f29f80d-647c-5b75-95a2-8f69ed785ceb": {
      "name": "service",
      "source": {
        "repo": "orenaksakal/railway-templates",
        "branch": "codex/remaining-template-drafts"
      },
      "variables": {
        "REDIS_HOST": {
          "isOptional": false,
          "description": "Private Redis/Valkey hostname supplied by the redis service reference.",
          "defaultValue": "${{redis.RAILWAY_PRIVATE_DOMAIN}}"
        },
        "REDIS_PASSWORD": {
          "isOptional": false,
          "description": "Generated private Redis/Valkey password, or a reference to that password. Keep secret.",
          "defaultValue": "${{redis.REDIS_PASSWORD}}"
        },
        "RAILWAY_DOCKERFILE_PATH": {
          "defaultValue": "templates/agentscope/Dockerfile",
          "isOptional": false,
          "description": "Repository-relative Dockerfile used to build this service. Keep the supplied path."
        }
      },
      "deploy": {
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10,
        "requiredMountPath": "/data"
      },
      "networking": {
        "serviceDomains": {}
      },
      "build": {
        "builder": "RAILPACK",
        "dockerfilePath": "templates/agentscope/Dockerfile"
      },
      "volumeMounts": {
        "55be77f9-e2c9-5839-b576-fe0ee19162e8": {
          "mountPath": "/data"
        }
      }
    },
    "63992218-d33a-55ca-8a17-d119e6b52358": {
      "name": "agentscope",
      "source": {
        "repo": "orenaksakal/railway-templates",
        "branch": "codex/remaining-template-drafts"
      },
      "variables": {
        "UPSTREAM_HOST": {
          "isOptional": false,
          "description": "Upstream host resolved automatically from the linked service. Keep this reference when using the included topology.",
          "defaultValue": "${{service.RAILWAY_PRIVATE_DOMAIN}}"
        },
        "UPSTREAM_PORT": {
          "isOptional": false,
          "description": "Upstream port for agentscope. The supplied value follows the pinned upstream deployment; change only with its configuration guide.",
          "defaultValue": "8000"
        },
        "ACCESS_USER": {
          "isOptional": false,
          "description": "Access user for agentscope. The supplied value follows the pinned upstream deployment; change only with its configuration guide.",
          "defaultValue": "admin"
        },
        "ACCESS_PASSWORD": {
          "isOptional": false,
          "description": "Generated access password. Keep private and preserve with backups.",
          "defaultValue": "${{secret(64, \"abcdef0123456789\")}}"
        },
        "PORT": {
          "isOptional": false,
          "description": "HTTP port inside this service. Keep the default to match its Railway public port and health check.",
          "defaultValue": "8080"
        },
        "RAILWAY_DOCKERFILE_PATH": {
          "defaultValue": "shared/round4-gateway/Dockerfile",
          "isOptional": false,
          "description": "Repository-relative Dockerfile used to build this service. Keep the supplied path."
        }
      },
      "deploy": {
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10,
        "healthcheckPath": "/healthz",
        "healthcheckTimeout": 600
      },
      "networking": {
        "serviceDomains": {
          "<hasDomain>:8080": {
            "port": 8080
          }
        }
      },
      "build": {
        "builder": "RAILPACK",
        "dockerfilePath": "shared/round4-gateway/Dockerfile"
      }
    }
  }
}
